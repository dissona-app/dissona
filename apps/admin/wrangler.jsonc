// Deploy no Cloudflare Workers via OpenNext — ver docs/architecture.md §9.
// Segredos (SUPABASE_SERVICE_ROLE_KEY, ASAAS_*) e as variáveis de build
// (NEXT_PUBLIC_*) ficam no painel do Cloudflare, nunca aqui.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dissona-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "dissona-admin" }],
  // O banco está em us-west-2 e o middleware faz um getUser() por requisição:
  // o Smart Placement põe o worker perto do Supabase, e não do visitante.
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  // Preserva as variáveis definidas no painel (PAGAMENTO_SIMULADO etc.): sem
  // isto, cada deploy apagaria o que não está neste arquivo.
  "keep_vars": true,
  // Endereço `*.workers.dev` ligado: dá para testar o Worker antes do domínio
  // próprio (e se ele cair), sem depender do DNS.
  "workers_dev": true,
  "preview_urls": true,
  // Domínio próprio (admin.dissona.com.br): volta para cá, como
  //   "routes": [{ "pattern": "admin.dissona.com.br", "custom_domain": true }]
  // assim que a zona dissona.com.br estiver ativa na conta. Antes disso o deploy
  // inteiro falha ("Can't infer zone"). E tem de ser aqui, e não no painel: o
  // wrangler trata este arquivo como a fonte da verdade e remove no deploy o
  // domínio que só existe no painel.
}

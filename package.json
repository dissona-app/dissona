{
  "name": "dissona",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace de avaliação estruturada e paga de músicas — artistas independentes e curadores profissionais. Monorepo: apps/web, apps/admin e packages/nucleo.",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "pnpm --filter @dissona/web dev",
    "dev:admin": "pnpm --filter @dissona/admin dev",
    "build": "pnpm -r --filter \"./apps/**\" build",
    "start": "pnpm --filter @dissona/web start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "e2e": "playwright test",
    "prototipo": "node scripts/extrair-prototipo.mjs",
    "prototipo:imagens": "node scripts/extrair-imagens-prototipo.mjs",
    "prototipo:fontes": "node scripts/extrair-fontes-prototipo.mjs",
    "supabase": "supabase",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:tipos": "node scripts/gerar-tipos-bd.mjs",
    "e2e:navegadores": "playwright install --with-deps chromium",
    "e2e:relatorio": "playwright show-report",
    "e2e:semear": "node scripts/repor-cenarios-e2e.mjs",
    "rastreabilidade": "node scripts/matriz-rastreabilidade.mjs",
    "postinstall": "node scripts/ligar-env.mjs"
  },
  "devDependencies": {
    "@dissona/nucleo": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.114.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "next": "16.3.4",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "supabase": "^2.116.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}

# Copie para .env.local e preencha.
# Valores em Supabase → Project Settings → API.

# Obrigatórias — cliente do browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente server-side. Ignora RLS — nunca exponha no client, e nunca com
# prefixo NEXT_PUBLIC_.
#
# Deixou de ser opcional na fatia de autenticação. Três coisas dependem dela, e
# nenhuma tem outro caminho:
#   - `registrar_notificacao` é revogada até de `authenticated` (migration 0005);
#   - `auth.sessions`, que alimenta o painel de "Sessões ativas" (7.4 / 17.4);
#   - `auth.admin.inviteUserByEmail`, do convite de membro (27.3).
#
# Sem ela o app **sobe**: `servicoNotificacao` avisa no log e segue, porque um
# aviso interno não gravado não é razão para o cadastro de alguém falhar. O que
# não funciona é o convite de admin e o painel de sessões.
SUPABASE_SERVICE_ROLE_KEY=

# Chave de emergência do login com SoundCloud (TASK-112). O botão vem
# **ligado**: o provider `custom:soundcloud` é do projeto Supabase, e Preview e
# Production compartilham o mesmo projeto — onde o app roda, o provider existe.
# Só `SOUNDCLOUD_LIGADO=false` desliga, e é o que fazer se a API deles cair ou a
# assinatura Artist Pro expirar. O client_id e o segredo não vêm daqui: vivem no
# dashboard do Supabase.
# SOUNDCLOUD_LIGADO=false

# R1 — e-mail transacional (provedor a definir, open-questions #10)
# R2 — Spotify, YouTube (metadados de faixa por link)

# Provedor de pagamento do checkout (5.2).
#
# Vem **ligado**, e por isso não está na lista de obrigatórias: um ambiente sem
# credencial do Asaas é o caso comum, e o simulador é o que o protótipo da R2
# desenha — a tela tem o seletor "Simular resultado · Aprovado / Recusado" e a
# nota de que nada é cobrado.
#
# O Asaas **existe e está implementado** para a compra de Claves (Pix com QR
# code, cartão e webhook). O que segue bloqueado por open-questions #6 é o
# repasse ao curador: split, subconta e KYC, decisão do contador do cliente.
#
# ⚠️ Enquanto isto não for `false`, a compra credita Claves sem cobrança
# nenhuma. `PAGAMENTO_SIMULADO=false` liga o Asaas (Pix e cartão), e exige
# ASAAS_API_KEY, ASAAS_WEBHOOK_TOKEN e SUPABASE_SERVICE_ROLE_KEY.
# PAGAMENTO_SIMULADO=false

# Admin em subdomínio próprio: admin.dissona.com.br (e admin.localhost:3000 em
# dev), com URLs limpas (/entrar, /equipe, /pacotes). O modo é decidido pelo
# host — em admin.* o admin sempre responde —; esta flag decide só se o host
# principal **redireciona** o /admin/... para lá (308).
#
# Ligue em Production na Vercel depois de adicionar o domínio e o CNAME, e no
# .env.local. Deixe desligada em Preview: o domínio por branch da Vercel não tem
# subdomínio, e o admin segue em /admin/... Ver docs/architecture.md §3.
# ADMIN_EM_SUBDOMINIO=true

# ---------------------------------------------------------------------------
# R2 — Asaas (compra de Claves: Pix e cartão)
# ---------------------------------------------------------------------------
#
# Somente server-side. A chave identifica a conta inteira — nunca com prefixo
# NEXT_PUBLIC_, nunca no browser.
#
# A API autentica pelo header `access_token`, e **não** por `Authorization`.
# Chave de sandbox começa com `$aact_hmlg_`; a de produção, `$aact_prod_`. Usar
# uma no endpoint da outra devolve 401.
#
# ⚠️ No `.env.local`, escreva o `$` inicial como `\$` (ASAAS_API_KEY=\$aact_…):
# o Next expande `$nome` em arquivos .env, e sem a barra a chave chega VAZIA ao
# servidor — o checkout falha com "compra indisponível". Na Vercel, cole a
# chave como está.
ASAAS_API_KEY=

# Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# Token de autenticação do webhook. O Asaas o devolve **uma única vez**, na
# criação do webhook, e o envia de volta no header `asaas-access-token` a cada
# notificação — o route handler compara antes de processar qualquer coisa.
#
# Sem ele, qualquer um que descubra a URL credita Claves na carteira de
# qualquer artista. Precisa ser forte: o Asaas recusa token curto, com
# sequência numérica (12345) ou com 4 letras repetidas.
ASAAS_WEBHOOK_TOKEN=

# Suite E2E — senha das contas de teste (namespace @e2e.dissona.local).
# Escolha um valor, ponha aqui no seu .env.local e rode
# supabase/testes/dados-e2e.sql com a mesma senha. No CI, vem de um secret.
# Sem ela, `pnpm e2e` falha dizendo exatamente isto.
# E2E_SENHA=
